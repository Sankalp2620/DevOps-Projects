# Environment Variables Template
# Copy this to .env.staging or .env.prod and fill in actual values

DB_IMAGE=sankalp2620/docker:db
FRONTEND_IMAGE=sankalp2620/docker:frontend
AUTH_IMAGE=sankalp2620/docker:auth
BOOK_IMAGE=sankalp2620/docker:book
BORROW_IMAGE=sankalp2620/docker:borrow

DB_ROOT_PASSWORD=your_db_root_password
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

FRONTEND_PORT=5000
FRONTEND_REPLICAS=3
SERVICE_REPLICAS=3